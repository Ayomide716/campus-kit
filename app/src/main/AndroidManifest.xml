<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lecture/exam/timer notifications (asked at runtime on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- On-time reminders; the user can grant or deny it in system settings. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Restore reminders after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional full-silent mode in lectures (user grants Do Not Disturb access). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Deliberately no INTERNET permission: all data stays on the phone. -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CampusKit">

        <activity
            android:name=".screens.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".screens.TimetableActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".screens.GpaActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".screens.AttendanceActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".screens.StudyActivity" android:launchMode="singleTop" />
        <activity android:name=".screens.ExamsActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".screens.BudgetActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".screens.DecksActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".screens.DeckActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".screens.CardStudyActivity" />
        <activity android:name=".screens.SettingsActivity" />

        <receiver
            android:name=".system.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".system.SystemEventsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
